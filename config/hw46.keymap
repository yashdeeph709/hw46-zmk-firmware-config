#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/*
 * HW46 keymap, 46 keys. Position order on every layer (reading order, seen from above):
 *   row 1 left (7), row 1 right (7), row 2 left (7), row 2 right (7),
 *   row 3 left (6), row 3 right (6), thumb left (3), thumb right (3)
 * Left half lists keys outer -> inner, right half lists inner -> outer.
 *
 * Key positions (0-based) used by the home-row Shift:
 *   left half : 0-6, 14-20, 28-33, 40-42
 *   right half: 7-13, 21-27, 34-39, 43-45
 */

/ {
    behaviors {
        /* F: tap = F, hold = Left Shift, but only when the next key is on the RIGHT half */
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45>;
            hold-trigger-on-release;
        };

        /* J: tap = J, hold = Right Shift, but only when the next key is on the LEFT half */
        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                // row 1 left
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp LBKT
                // row 1 right
                &kp RBKT        &kp Y           &kp U           &kp I           &kp O           &kp P           &kp BSPC
                // row 2 left
                &kp LCTRL       &kp A           &kp S           &kp D           &hml LSHFT F    &kp G           &kp MINUS
                // row 2 right
                &kp EQUAL       &kp H           &hmr RSHFT J    &kp K           &kp L           &kp SEMI        &kp SQT
                // row 3 left
                &kp LGUI        &kp Z           &kp X           &kp C           &kp V           &kp B
                // row 3 right
                &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp BSLH
                // thumb left
                &kp ESC         &mo LOWER       &kp SPACE
                // thumb right
                &kp RET         &mo RAISE       &kp LALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                // row 1 left
                &kp GRAVE       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6
                // row 1 right
                &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &trans
                // row 2 left
                &trans          &trans          &trans          &trans          &trans          &trans          &trans
                // row 2 right
                &kp DEL         &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp HOME        &kp END
                // row 3 left
                &trans          &kp LC(Z)       &kp LS(DEL)     &kp LC(INS)     &kp LS(INS)     &trans
                // row 3 right
                &kp PG_DN       &kp PG_UP       &trans          &trans          &trans          &trans
                // thumb left
                &trans          &trans          &trans
                // thumb right
                &trans          &trans          &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
                // row 1 left
                &kp TILDE       &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &kp CARET
                // row 1 right
                &kp AMPS        &kp STAR        &kp QMARK       &kp COLON       &kp DQT         &kp SQT         &trans
                // row 2 left
                &trans          &kp BSLH        &kp PIPE        &kp MINUS       &kp UNDER       &kp EQUAL       &kp PLUS
                // row 2 right
                &trans          &kp LPAR        &kp RPAR        &kp LBRC        &kp RBRC        &kp LBKT        &kp RBKT
                // row 3 left
                &trans          &kp GRAVE       &kp SQT         &kp DQT         &kp LT          &kp GT
                // row 3 right
                &kp LT          &kp GT          &kp EQUAL       &kp PLUS        &kp UNDER       &trans
                // thumb left
                &trans          &trans          &trans
                // thumb right
                &trans          &trans          &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
                // row 1 left
                &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7
                // row 1 right
                &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &kp PRINTSCREEN  &trans
                // row 2 left
                &trans          &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP
                // row 2 right
                &studio_unlock  &trans          &trans          &trans          &trans          &trans          &trans
                // row 3 left
                &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR
                // row 3 right
                &trans          &kp K_APP       &trans          &trans          &trans          &trans
                // thumb left
                &trans          &trans          &trans
                // thumb right
                &trans          &trans          &trans
            >;
        };

        /* spare layers that ZMK Studio can use */
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
